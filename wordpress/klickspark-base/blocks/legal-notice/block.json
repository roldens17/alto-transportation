{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ks/legal-notice",
  "title": "Legal notice",
  "category": "text",
  "icon": "shield-alt",
  "description": "Required advertising and no-relationship notice, pulled from site config.",
  "supports": { "html": false, "align": ["wide"], "spacing": { "margin": true, "padding": true } },
  "attributes": {
    "variant": { "type": "string", "default": "stamp" },
    "text": { "type": "string", "default": "" }
  },
  "textdomain": "ks-base",
  "render": "file:./render.php",
  "style": "file:./style.css"
}
