{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "44rem", "wideSize": "76rem" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "base", "color": "#ffffff", "name": "Base" },
        { "slug": "contrast", "color": "#111111", "name": "Contrast" },
        { "slug": "primary", "color": "#111111", "name": "Primary" },
        { "slug": "secondary", "color": "#666666", "name": "Secondary" },
        { "slug": "surface", "color": "#f5f5f5", "name": "Surface" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontSizes": [
        { "slug": "small", "size": "0.875rem", "name": "Small" },
        { "slug": "medium", "size": "1rem", "name": "Medium" },
        { "slug": "large", "size": "clamp(1.25rem, 2vw, 1.5rem)", "name": "Large" },
        { "slug": "x-large", "size": "clamp(1.75rem, 4vw, 2.5rem)", "name": "Extra large" },
        { "slug": "xx-large", "size": "clamp(2.25rem, 6vw, 4rem)", "name": "Display" }
      ]
    },
    "spacing": {
      "units": ["rem", "%", "vw", "vh"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "20", "size": "0.5rem", "name": "1" },
        { "slug": "30", "size": "0.75rem", "name": "2" },
        { "slug": "40", "size": "1rem", "name": "3" },
        { "slug": "50", "size": "1.75rem", "name": "4" },
        { "slug": "60", "size": "3rem", "name": "5" },
        { "slug": "70", "size": "5rem", "name": "6" },
        { "slug": "80", "size": "8rem", "name": "7" }
      ]
    },
    "custom": {
      "radius": "6px",
      "error": "#b3261e"
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--contrast)" },
    "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
    "spacing": { "padding": { "left": "var(--wp--preset--spacing--40)", "right": "var(--wp--preset--spacing--40)" } },
    "elements": {
      "link": { "color": { "text": "var(--wp--preset--color--primary)" }, "typography": { "textDecoration": "underline" } },
      "heading": { "typography": { "lineHeight": "1.15", "fontWeight": "700" } }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-booking", "title": "Booking page", "postTypes": ["page"] }
  ]
}
